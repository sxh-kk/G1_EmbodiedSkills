@@ -0,0 +1,80 @@
+"""SONIC's WXYZ quaternion contract at the Isaac Lab 3 XYZW boundary.
+
+Only SONIC imports this module. Isaac Lab's internal math and data stay XYZW;
+checkpoint observations and the released motion library keep their WXYZ semantics.
+"""
+import torch
+from isaaclab.utils import math as native
+
+sample_uniform = native.sample_uniform
+
+
+def to_lab(q):
+    return torch.cat((q[..., 1:], q[..., :1]), dim=-1)
+
+
+def from_lab(q):
+    q = q.torch if hasattr(q, 'torch') else q
+    return torch.cat((q[..., -1:], q[..., :3]), dim=-1)
+
+
+def write_root_state(asset, state, env_ids=None):
+    state = state.clone()
+    state[..., 3:7] = to_lab(state[..., 3:7])
+    asset.write_root_state_to_sim(state, env_ids=env_ids)
+
+
+def write_root_pose(asset, pose, env_ids=None):
+    pose = pose.clone()
+    pose[..., 3:7] = to_lab(pose[..., 3:7])
+    asset.write_root_pose_to_sim(pose, env_ids=env_ids)
+
+
+def matrix_from_quat(q):
+    return native.matrix_from_quat(to_lab(q))
+
+
+def quat_apply(q, v):
+    return native.quat_apply(to_lab(q), v)
+
+
+def quat_apply_inverse(q, v):
+    return native.quat_apply_inverse(to_lab(q), v)
+
+
+quat_rotate_inverse = quat_apply_inverse
+
+
+def quat_apply_yaw(q, v):
+    return native.quat_apply_yaw(to_lab(q), v)
+
+
+def quat_conjugate(q):
+    return from_lab(native.quat_conjugate(to_lab(q)))
+
+
+def quat_inv(q):
+    return from_lab(native.quat_inv(to_lab(q)))
+
+
+def quat_mul(q1, q2):
+    return from_lab(native.quat_mul(to_lab(q1), to_lab(q2)))
+
+
+def quat_error_magnitude(q1, q2):
+    return native.quat_error_magnitude(to_lab(q1), to_lab(q2))
+
+
+def quat_from_euler_xyz(roll, pitch, yaw):
+    return from_lab(native.quat_from_euler_xyz(roll, pitch, yaw))
+
+
+def axis_angle_from_quat(q, eps=1.0e-6):
+    return native.axis_angle_from_quat(to_lab(q), eps)
+
+
+def subtract_frame_transforms(t01, q01, t02=None, q02=None):
+    t12, q12 = native.subtract_frame_transforms(
+        t01, to_lab(q01), t02, None if q02 is None else to_lab(q02)
+    )
+    return t12, from_lab(q12)
